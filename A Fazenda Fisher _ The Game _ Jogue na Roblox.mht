@media (max-width: 543px) {
  .access-management-upsell-modal { padding: 0px; }
}

.access-management-upsell-modal #access-management-modal-title { text-align: center; width: 100%; padding: 0px; }

.access-management-upsell-modal .close { float: left; }

@media (max-width: 767px) {
  .access-management-upsell-modal #access-management-upsell-close-button { margin-top: -2px; }
}

.access-management-upsell-modal .modal-dialog { overflow: auto; }

@media (min-width: 543px) {
  .access-management-upsell-modal .modal-dialog { min-width: 510px; }
}

.access-management-upsell-modal .modal-dialog .modal-content { border-radius: 8px; }

.access-management-upsell-modal .modal-dialog .modal-content .modal-body { white-space: pre-wrap; margin: 0px 12px 24px; padding-bottom: 20px; }

.access-management-upsell-modal .modal-dialog .modal-content .modal-footer { margin: 0px 24px 24px; }

.parental-consent-modal-body { text-align: center; margin-bottom: 12px; }

.account-settings-redirect-modal .modal-body { white-space: pre-line; }

@media (max-width: 543px) {
  .access-management-upsell-inner-modal { padding: 0px; }
}

.access-management-upsell-inner-modal .modal-dialog { overflow: auto; }

@media (min-width: 543px) {
  .access-management-upsell-inner-modal .modal-dialog { min-width: 510px; }
}

.access-management-upsell-inner-modal .modal-dialog .modal-content { border-radius: 8px; }

.access-management-upsell-inner-modal .modal-dialog .modal-content .modal-header { text-align: center; }

.access-management-upsell-inner-modal .modal-dialog .modal-content .modal-header .modal-title { padding: 0px 30px; }

.access-management-upsell-inner-modal .modal-dialog .modal-content .modal-header .close-button { position: absolute; top: 12px; left: 12px; }

.access-management-upsell-inner-modal .modal-dialog .modal-content .modal-body { margin: 0px 12px; }

.access-management-upsell-inner-modal .modal-dialog .modal-content .modal-body .form-horizontal .form-group { width: 100%; }

.access-management-upsell-inner-modal .modal-dialog .modal-content .modal-body .form-horizontal .form-group .modal-error-message { white-space: normal; }

.access-management-upsell-inner-modal .modal-dialog .modal-content .modal-footer .modal-half-width-button { width: calc(100% - 8px); margin: 6px 0px; }

@media (min-width: 543px) {
  .access-management-upsell-inner-modal .modal-dialog .modal-content .modal-footer { margin: 0px 20px 20px; display: flex; }
  .access-management-upsell-inner-modal .modal-dialog .modal-content .modal-footer .modal-half-width-button { width: calc(50% - 8px); margin: 0px 6px; }
}

.access-management-upsell-inner-modal .modal-dialog .modal-content .modal-footer .modal-full-width-button { width: calc(100% - 8px); margin: 6px 0px; }

.parent-email-image, .ask-your-parent-lock { background-position: 50% center; background-repeat: no-repeat; background-size: auto 142px; height: 142px; margin: 24px 0px; }

.parent-email-image, .light-theme .parent-email-image { background-image: url("https://images.rbxcdn.com/af45aa0a7fb8a029.png"); }

.dark-theme .parent-email-image, .color-mode-dark .parent-email-image { background-image: url("https://images.rbxcdn.com/18fc22df4975f378.png"); }

@media (prefers-color-scheme: dark) {
  .color-mode-system .parent-email-image { background-image: url("https://images.rbxcdn.com/18fc22df4975f378.png"); }
}

.ask-your-parent-lock, .light-theme .ask-your-parent-lock { background-image: url("https://images.rbxcdn.com/08838c2d801193f2.png"); }

.dark-theme .ask-your-parent-lock, .color-mode-dark .ask-your-parent-lock { background-image: url("https://images.rbxcdn.com/e507e138a7bacd4d.png"); }

@media (prefers-color-scheme: dark) {
  .color-mode-system .ask-your-parent-lock { background-image: url("https://images.rbxcdn.com/e507e138a7bacd4d.png"); }
}

