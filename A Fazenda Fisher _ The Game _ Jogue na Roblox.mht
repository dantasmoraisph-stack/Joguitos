#game-details-carousel-container::before { content: ""; width: 100%; padding-top: 56.25%; display: block; }

#game-details-carousel-container > div { position: absolute; inset: 0px; }

#game-details-carousel-container .icon-pending { background-position: 50% center; background-repeat: no-repeat; background-size: cover; }

