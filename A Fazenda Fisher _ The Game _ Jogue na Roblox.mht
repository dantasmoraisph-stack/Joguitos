.stack .card-list .card-item.card-item-public-server { min-height: 250px; }

.stack .card-list .player-thumbnails-container .player-avatar.hidden-players-placeholder { border-radius: 50%; justify-content: center; align-items: center; display: inline-flex; }

.light-theme .stack .card-list .player-thumbnails-container .player-avatar.hidden-players-placeholder { background-color: color-mix(in srgb,var(--color-extended-gray-300)90%,transparent); }

.dark-theme .stack .card-list .player-thumbnails-container .player-avatar.hidden-players-placeholder { background-color: var(--color-extended-gray-600); }

.stack .server-list-section { overflow: hidden; }

.stack .server-player-count-gauge { border-radius: 8px; width: 100%; height: 6px; margin: 2px 0px 4px; overflow: hidden; }

.light-theme .stack .server-player-count-gauge { background-color: var(--color-surface-0); border-color: var(--color-extended-gray-500); }

.dark-theme .stack .server-player-count-gauge { background-color: var(--color-surface-0); border-color: var(--color-extended-gray-700); }

.stack .server-player-count-gauge .gauge-inner-bar { width: 100%; height: 100%; }

.light-theme .stack .server-player-count-gauge .gauge-inner-bar { background-color: var(--color-extended-gray-500); border-top-color: ; border-bottom-color: ; border-left-color: ; border-right-color: var(--color-extended-black-30); }

.dark-theme .stack .server-player-count-gauge .gauge-inner-bar { background-color: var(--color-extended-gray-500); border-top-color: ; border-bottom-color: ; border-left-color: ; border-right-color: var(--color-extended-white-30); }

@media (max-width: 468px) {
  .stack .card-list .card-item { min-height: 306px; }
  .stack .card-list .card-item .player-thumbnails-container { max-width: 126px; }
}

@media (max-width: 336px) {
  .stack .card-list li { width: 100%; }
  .stack .card-list li .card-item { min-height: 240px; }
  .stack .card-list li .card-item .player-thumbnails-container { max-width: 192px; }
}

@media (max-width: 767px) {
  .server-list-options { flex-direction: column; align-items: flex-start; }
  .server-list-options .checkbox { margin-top: 12px; margin-left: 0px; }
}

.in-app #running-game-instances-container { max-width: 970px; margin: 0px auto; }

.rbx-private-server-subscription-alert { text-align: center; margin-bottom: 6px; }

.rbx-private-server-renewal-disclosure { text-align: center; }

#redirect-link { text-decoration: underline; }

.private-settings-disclaimer { flex: 1 1 0%; display: flex; }

#privacy-settings-disclaimer-checkbox { flex-direction: row; margin-right: 0.5rem; }

#private-settings-disclaimer-text { flex-direction: row; display: flex; }

