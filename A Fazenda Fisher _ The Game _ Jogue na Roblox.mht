.carousel-item[class*="icon-"] { background-position: 50% center; padding-top: 0px; }

.carousel-video { height: 0px; padding-bottom: 56.25%; }

.carousel-video iframe { width: 100%; height: 100%; position: absolute; top: 0px; left: 0px; }

.carousel-video.game-preview-video-container .video-preview-wrapper { opacity: 0; visibility: hidden; transition: opacity 0.5s ease-in-out; }

